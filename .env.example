# Copier ce fichier vers .env et remplacer par tes IDs d’UNITÉ bannière AdMob (format ca-app-pub-…/… avec un SLASH, pas ~).
# Les App ID (avec ~) restent dans app.json — ce sont deux choses différentes.
#
# Récupération : console AdMob → Applications → ton app → Blocs publicitaires → Bannière → ID du bloc.
#
# EAS Build (cloud) : ajoute les MÊMES variables sur https://expo.dev
#   → ton projet → Environment variables → Production (ou eas env:create en CLI).
# Sinon le build prod n’aura pas les IDs et les bannières ne s’afficheront pas.

EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=

# Optionnel (développement) : 1 = afficher un bandeau « image test » + logs AdMob dans la console
EXPO_PUBLIC_ADMOB_DEBUG_PREVIEW=1
EXPO_PUBLIC_ADMOB_VERBOSE_LOGS=1

# Optionnel — Sentry (erreurs en prod). Sans DSN, rien n’est envoyé.
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
