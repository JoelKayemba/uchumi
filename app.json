{
  "expo": {
    "name": "uchumi",
    "slug": "uchumi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/MODEL2.png",
    "scheme": "uchumi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uchumi.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.uchumi.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3FA",
        "foregroundImage": "./assets/logo/MODEL2.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/MODEL2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/MODEL2.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F5F3FA",
          "dark": {
            "backgroundColor": "#F5F3FA"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#352E2C",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UCHUMI accède à vos photos pour joindre une image à un mouvement.",
          "cameraPermission": "UCHUMI utilise la caméra pour joindre une photo à un mouvement."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1506684321153972~8812645427",
          "iosAppId": "ca-app-pub-1506684321153972~5064972108"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37f257ce-ee0d-4a41-b686-aa6dc44e4e32"
      }
    }
  }
}
